{
  "name": "eterminal",
  "version": "0.1.0",
  "description": "A fast optical liquid-glass terminal with a real PTY and an AI output reader for Claude Code.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5273 && electron . --dev\"",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "preview": "vite preview",
    "test": "node --experimental-strip-types --no-warnings --test tests/parser.test.mts",
    "icon": "electron scripts/gen-icon.cjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edemiaochu/ETerminal.git"
  },
  "keywords": [
    "terminal",
    "electron",
    "liquid-glass",
    "webgl",
    "xterm",
    "ai",
    "claude-code",
    "pty"
  ],
  "author": "ETerminal contributors",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/edemiaochu/ETerminal/issues"
  },
  "homepage": "https://github.com/edemiaochu/ETerminal#readme",
  "private": true,
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.5.0",
    "highlight.js": "^11.12.0",
    "marked": "^18.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "concurrently": "^10.0.7",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  },
  "productName": "ETerminal",
  "engines": {
    "node": ">=22.12.0"
  },
  "build": {
    "appId": "com.eterminal.app",
    "productName": "ETerminal",
    "asar": true,
    "npmRebuild": false,
    "compression": "normal",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/renderer/**/*",
      "electron/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "node_modules/@lydell/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "ETerminal-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ETerminal",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "extraResources": [
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      }
    ]
  }
}
